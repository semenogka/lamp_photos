<script>
	function objectToQueryString(obj) {
		const buildQueryString = (prefix, obj) => {
			return Object.keys(obj).map(key => {
				const value = obj[key];
				const prefixedKey = prefix ? `${prefix}[${key}]` : key;

				if (Array.isArray(value)) {
					return value.map((val, index) => `${encodeURIComponent(prefixedKey)}[${index}]=${encodeURIComponent(val)}`).join('&');
				} else if (typeof value === 'object' && value !== null) {
					return buildQueryString(prefixedKey, value);
				} else {
					return `${encodeURIComponent(prefixedKey)}=${encodeURIComponent(value)}`;
				}
			}).join('&');
		};

		return buildQueryString('', obj);
	}


		function article_filter() {
			
			let get = {};
			
			$('.articles-filter .btn-tag.active').each(function(){
				let name = $(this).attr('data-name');
				let v = $(this).attr('data-id');
				if(!get[name]) {
					get[name] = new Array();
				}
				get[name].push(v);
				
			});
			if($('#flexSwitchCheckArticle').is(':checked')) {
				get['only_articles'] = 'Y';
			}
			if($('#flexSwitchCheckVideo').is(':checked')) {
				get['only_video'] = 'Y';
			}
			
			
			
			let a = objectToQueryString(get);
			
			$.get(location.pathname,a,function(data){
				
				let h = $('<div>'+data+'</div>').find('.the-list').html();
				$('.the-list').html(h);
				
			});
			
		}
		
		$('.articles-filter .btn-tag').click(function(){
			article_filter();
		});
		$('#flexSwitchCheckArticle').change(function(){
			
			if($(this).is(':checked')) {
				$('#flexSwitchCheckVideo').prop('checked',false);
			}
			article_filter();
		});
		$('#flexSwitchCheckVideo').change(function(){
			
			if($(this).is(':checked')) {
				$('#flexSwitchCheckArticle').prop('checked',false);
			}
			article_filter();
		});
		
		
function productFilter() {
	
	let q = new Array();
	q.push('ajax_request=Y');
	
	var urlpart = location.href.split('?');
	if(urlpart[1]) {
		q.push(urlpart[1]);
	}
	
	
	if($('#flexSwitchCheckNewItems').is(':checked')) {
		q.push('new=Y');
	}
	if($('#flexSwitchCheckStock').is(':checked')) {
		q.push('action=Y');
	}
	if($('#flexSwitchCheckVideo').is(':checked')) {
		q.push('video=Y');
	}
	if($('#flexSwitchCheck3DModel').is(':checked')) {
		q.push('3d=Y');
	}
	
	if($('#faz3_1').is(':checked')) {
		q.push('subsection[]=Шинопроводы');
	}
	if($('#faz3_2').is(':checked')) {
		q.push('subsection[]=Светильники');
	}
	if($('#faz3_3').is(':checked')) {
		q.push('subsection[]=Комплектующие');
	}
	if($('#faz3_4').is(':checked')) {
		q.push('subsection[]=Драйверы');
	}
	if($('#faz3_5').is(':checked')) {
		q.push('subsection[]=Умные светильники');
	}
	
	if($('#flum48_1').is(':checked')) {
		q.push('subsection_tip_montazha[]='+$('#flum48_1').val());
	}
	if($('#flum48_2').is(':checked')) {
		q.push('subsection_tip_montazha[]='+$('#flum48_2').val());
	}
	if($('#flum48_3').is(':checked')) {
		q.push('subsection_tip_montazha[]='+$('#flum48_3').val());
	}
	
	
	if($('#complfilter.active').length) {
		q.push('type[]='+$('#complfilter.active').text());
	}
	$('.sub-type-filter.active').each(function(){
		q.push('type[]='+$(this).attr('data-value'));
	});
	$('.brand-filter.active').each(function(){
		q.push('brand[]='+$(this).text());
	});
	
		
	
	let url = location.pathname+'?'+q.join('&');
	
	$('.smartfilter').attr('action',url);
	
	$.get(url,function(data){
		
		let h = $('<div>'+data+'</div>').find('.product-list').html();
		let smw = $('<div>'+data+'</div>').find('.show-more-wrapper').html();
		
		
		$('.product-list').html(h);
		$('.show-more-wrapper').html(smw);
		
			
			if(!smw) 
				$('.show-more-wrapper').html('');
		
				$('.popup-card-slider').each(function(i){
				
					var id = $(this).attr('data-id');
					
						
						swiper_popup_card_slider[id] = new Swiper('#pcs'+id, {
							// Optional parameters
							slidesPerView: 1,
							spaceBetween: 20,
							loop: false,

							// If we need pagination
							// pagination: {
							// 	el: '.popup-card-pagination',
							// 	dynamicBullets: true,
							// 	clickable: true,
							// },

							// Navigation arrows
							navigation: {
								nextEl: '.popup-card-button-next-'+id,
								prevEl: '.popup-card-button-prev-'+id,
							},
						});
					
					
					
				});
	});
	
	
}
$(document).ready(function () {
	
    window.addEventListener('pageshow', function (event) {
        // Проверяем, не является ли это первоначальной загрузкой
        if (event.persisted || performance.navigation.type === PerformanceNavigation.TYPE_BACK_FORWARD) {
			if($('#catalog-main-column [type="checkbox"]:checked').length) {
				
				productFilter();
			}
        }
    });
});


function printSetItem(name,selector) {
	
	let h = ''+
	
		'<button type="button" class="btn btn-tag_ d-flex justify-content-between align-items-center gap-2 set-filter-item" data-selector="#'+selector+'">'+
				name+' <span role="button" class="btn-close" tabindex="0"></span>'+
		'</button>';

	$('.set-filter-block').append(h);
}

$('.product-filter-item').change(function(){
	
	productFilter();
	
	let n = $(this).parent().find('label').text();
	let id = $(this).parent().find('label').attr('for');
	
	if($(this).is(':checked') && !$(this).parents('#catalog-main-column').length) {
	
		printSetItem(n,id);
	
	} else {
		
		$('[data-selector="#'+id+'"]').remove();
	
	}
	
	
});
$('.product-filter-item:checked').each(function(){
	
	let n = $(this).parent().find('label').text();
	let id = $(this).parent().find('label').attr('for');
	if(!$(this).parents('#catalog-main-column').length) {
		printSetItem(n,id);
	}
	
});
$('.product-filter-item2').change(function(){
	
	productFilter();
	
	
	
});


