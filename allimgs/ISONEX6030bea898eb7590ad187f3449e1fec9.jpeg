$('.product-sfilter-item').change(function(){
	
	//productFilter();
	
	let n = $(this).next().text();
	let id = $(this).next().attr('for');
	
	
	
	if($(this).is(':checked')) {
	
		printSetItem(n,id);
	
	} else {
		
		$('[data-selector="#'+id+'"]').remove();
	
	}
	
	var show_trek_filter = false;
	var show_trek_filter_driver = true;
	for(var i = 0;i < trek_params.length;i++) {
	
		if(trek_params[i] == id && $(this).is(':checked')) {
			show_trek_filter = true;
		}
		
	}
	for(var i = 0;i < trek_params_no_driver.length;i++) {
	
		if(trek_params_no_driver[i] == id && $(this).is(':checked')) {
			show_trek_filter_driver = false;
		}
		
	}
	
	if(show_trek_filter_driver) {
		$('.driver-filter-div').removeClass('hidden');
	} else {
		//$('.driver-filter-div').addClass('hidden');
	}
	
	if(show_trek_filter) {
		$('#trek_filters').removeClass('hidden');
	} else {
		//$('#trek_filters').addClass('hidden');
	}
	
	
	var show_flum48 = false;
	for(var i = 0;i < flum48_params.length;i++) {
	
		if(flum48_params[i] == id && $(this).is(':checked')) {
			show_flum48 = true;
		}
		
	}
	if(show_trek_filter) {
		$('#flum48_filters').removeClass('hidden');
	} else {
		//$('#flum48_filters').addClass('hidden');
	}
	
	
});

$('.btn-tag').click(function() {
	
	if($(this).parents('.set-filter-block').length) return false;
	
	$(this).parent().find('.btn-tag').removeClass('active');
	$(this).addClass('active');
	
	return false;
});
$('.type-filter').click(function(){
	
	//if($(this).hasClass('active')) return false;
	$('[data-selector="#complfilter"]').remove();
	
	let n = $(this).text();
	let id = $(this).attr('id');
	
	$('.sub-types').addClass('hidden');
	$('.sub-type-filter').removeClass('active');
	
	if($(this).hasClass('show-sub-types')) {
	
		let c = $(this).attr('data-code');
		$('.sub-types.type-'+c).removeClass('hidden');
		
		productFilter();
		
	} else if(!$(this).hasClass('show-all-products-2')) {
	
		productFilter();
		
		
		if($(this).hasClass('active')) {
			printSetItem(n,id);
		} else {
			$('[data-selector="#'+id+'"]').remove();
		}
	
	}
	
	return false;
});
$('.sub-type-filter').click(function(){
	
	$(this).toggleClass('active');
	productFilter();
	
	let n = $(this).text();
	let id = $(this).attr('id');
	
	if($(this).hasClass('active')) {
		printSetItem(n,id);
	} else {
		$('[data-selector="#'+id+'"]').remove();
	}
	
	return false;
});
$('.show-brands').click(function(){
	
	if(!$('.brands-list').hasClass('active')) {
		$('.brands-list').removeClass('hidden');
		$('.brand-filter').removeClass('active');
	}
	
	return false;
});
$('.brand-filter').click(function(){
	
	$(this).toggleClass('active');
	productFilter();
	
	let n = $(this).text();
	let id = $(this).attr('id');
	
	if($(this).hasClass('active')) {
		printSetItem(n,id);
	} else {
		$('[data-selector="#'+id+'"]').remove();
	}
	
	return false;
});
$('.show-all-products-1').click(function(){
	
	$('.brands-list').addClass('hidden');
	$('.brand-filter').removeClass('active');
	productFilter();
	
	$('.brand-filter').each(function(){
		let id = $(this).attr('id');
		$('[data-selector="#'+id+'"]').remove();
	});
	
	return false;
});
$('.show-all-products-2').click(function(){
	
	$('.sub-types').addClass('hidden');
	$('.sub-type-filter').removeClass('active');
	productFilter();
	
	$('.sub-type-filter').each(function(){
		let id = $(this).attr('id');
		$('[data-selector="#'+id+'"]').remove();
	});
	$('[data-selector="#complfilter"]').remove();
	
	return false;
});


$('body').on('click','.set-filter-item .btn-close',function(){
	
	let s = $(this).parent().attr('data-selector');
	
	
	if($(s).attr('type') == 'checkbox') {
		//$(s).prop('checked',false);
		//smartFilter.click($(s));
		$(s).trigger('click');
		
	} else if(s == 'complfilter') {
		$('#complfilter').removeClass('active');
		$('.show-all-products-2').addClass('active');
	} else {
		$(s).removeClass('active');
	}
	
	
	$(this).parent().remove();
	
	productFilter();
	
	return false;
});

$('.btn-reset-filter').click(function(){
	
	$('.set-filter-item .btn-close').each(function(){
		$(this).click();
	});
	
	return false;
});
	$('body').on('click','.show-all',function() {
		
		var wrapper = $(this).attr('data-wrapper');
		
		$(wrapper).find('.hidden').removeClass('hidden');
		$(this).remove();
		return false;
	});

	$('body').on('click','.show-more',function() {
			
		if(document.wait) return;
		
		var max = parseInt($(this).attr('data-pages'));
		var page = parseInt($(this).attr('data-page'));
		var wrapper = $(this).attr('data-wrapper');
		var param = $(this).attr('data-param');
		var t = $(this);
		
		if(t.hasClass('loading')) return false;
		
		t.addClass('downloading');
		
		var new_page = page + 1;
		
		var url_string = window.location.href;
		var url = new URL(url_string);
		var q = url.searchParams.get("q");
		
		if(!q && location.pathname == '/brands/' && $('.company__search-holder [name=q]').val())
			q = $('.company__search-holder [name=q]').val();
		
		//var url = location.pathname+'?';
		var h = location.hash;
		var url = location.href.replace(h,'');
		
		console.log(url);
		
		if(url.indexOf('?') != -1) {
			url += '&';
		} else {
			url += '?';
		}
		if(q) url += 'q='+q+'&';
		
		$('.product-line-list-filter input:checked').each(function(){
			
			url += 'subsection[]='+$(this).val()+'&';
			
		});
		$('.product-line-list-filter2 input:checked').each(function(){
			
			url += 'subsection_tip_montazha[]='+$(this).val()+'&';
			
		});
		
		
		
		var cookie_url = url+'PAGEN_'+param+'='+new_page;
		
		url = url+'PAGEN_'+param+'='+new_page+'&ncc=1';
		
		document.wait = true;
		
		$.get(url,function(data){
		
			var html = $(data).find(wrapper).html();
			var show_more = $(data).find('.show-more-wrapper').html();
			if(!show_more) show_more = ' ';
			
		//	console.log(show_more);
		//	console.log($('.show-more-wrapper'));
			
			$(wrapper).append(html);
			$('.show-more-wrapper').html(show_more);
			
			
			if(new_page >= max)
			{
				t.remove();
			}
			else
			{
				t.attr('data-page',new_page);
			}
			
			
			t.removeClass('downloading');
			
			document.wait = false;
			
		});
		
		return false;
	});
	
	
	$('body').on('click','.show-nal',function(){
		
		$(this).addClass('hidden');
		$(this).next().removeClass('hidden');
		
		return false;
	});
	
	$('.menu_lvl_1_items').click(function(){
		
		$('.menu_lvl_1_items').removeClass('active');
