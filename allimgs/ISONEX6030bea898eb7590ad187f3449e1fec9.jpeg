	$.get('/local/ajax/get-cart.php',function(data){
		
		$.each(data.items,function(k,v){
			
			$('.add-to-cart[data-id="'+v.PRODUCT_ID+'"]').parent().addClass('incart');
			$('.add-to-cart[data-id="'+v.PRODUCT_ID+'"]').parent().find('input').val(v.QUANTITY);
			$('.add-to-cart[data-id="'+v.PRODUCT_ID+'"]').parent().attr('data-bid',k);
			
		});
		
	},'json');
	
	$('body').on('click','.catalog-counter .catalog-minus',function(){
		
		var p = $(this).parents('.buy-row');
		var bid = $(this).attr('data-bid');
		var pid = p.find('.add-to-cart').attr('data-id');
		var q = parseInt(p.find('input').val());
		
		if(q > 1) q--;
		p.find('input').val(q);
		
		var bdata = {
			quantity : q,
			basket_ID: bid,
			product_ID : pid
		};
		
		$.post('/local/ajax/cart-update.php',bdata,function(data){
			
			$('.hcart_cnt').text(data.cnt);
			
			
		},'json');
		
		return false;
	});
	$('body').on('click','.catalog-counter .catalog-plus',function(){
		
		var p = $(this).parents('.buy-row');
		var bid = $(this).attr('data-bid');
		var pid = p.find('.add-to-cart').attr('data-id');
		var q = parseInt(p.find('input').val());
		
		 q++;
		p.find('input').val(q);
		
		var bdata = {
			quantity : q,
			basket_ID: bid,
			product_ID : pid
		};
		
		$.post('/local/ajax/cart-update.php',bdata,function(data){
			
			$('.hcart_cnt').text(data.cnt);
			
			
		},'json');
		
		return false;
	});
