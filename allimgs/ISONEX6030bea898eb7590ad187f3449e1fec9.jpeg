	function productLineListFilter() {
		
		
		
		var sub1 = new Array();
		$('.product-line-list-filter [type=checkbox]:checked').each(function(){
			
			var v = 'subsection[]='+$(this).val();
			sub1.push(v);
			
		});
		var sub2 = new Array();
		$('.product-line-list-filter2 [type=checkbox]:checked').each(function(){
			
			var v = 'subsection_tip_montazha[]='+$(this).val();
			sub2.push(v);
			
		});
		
		var url = location.pathname;
		
		$.get(url+'?'+sub1.join('&')+'&'+sub2.join('&'),function(data){
			
			$('[data-wrapper="#container-1"]').parent().show();
				
			var h = $('<div>'+data+'</div>').find('#container-1').html();
			var h2 = $('<div>'+data+'</div>').find('[data-wrapper="#container-1"]').parent().html();
			$('#container-1').html(h);
			if(!h2) {
				$('[data-wrapper="#container-1"]').parent().hide();
			} else {
				$('[data-wrapper="#container-1"]').parent().html(h2);
			}
			
		});
		
	}
	
	$('.product-line-list-filter [type=checkbox]').change(function(){
	
		productLineListFilter();
		
		
	});
	$('.product-line-list-filter2 [type=checkbox]').change(function(){
	
		productLineListFilter();
		
		
	});
	
	$('.menu-more-link').click(function(){
		
		$(this).parents('ul').find('.mb-hidden').toggleClass('hidden');
		if($(this).text() == 'Еще') {
			$(this).text('Свернуть');
			$(this).parent().css('margin-top','0px');
		} else {
			$(this).text('Еще');
			$(this).parent().css('margin-top','-16px');
		}
		
		
		
		return false;
	});
	
/*****fav compare****/

$(document).ready(function () {

  /* Favorites */
  $(document).on("click", '.add-to-fav', function (e) {
  
	e.stopPropagation();
  
    var favorID = $(this).attr("data-id");
    if ($(this).hasClass("favourite-add--active")) var doAction = "delete";
    else var doAction = "add";

    addFavorite(favorID, doAction);
  });
  /* Favorites */
});

/* Избранное */
function addFavorite(id, action) {
  var param = "id=" + id + "&action=" + action;
  $.ajax({
    url: "/include/ajax/favorite.php",
    type: "GET",
    dataType: "html",
    data: param,
    success: function (response) {
      var result = $.parseJSON(response);
      if (result.res == 1) {
        //$('.favourite-add[data-item="' + id + '"]').addClass(
        //  "favourite-add--active"
        //);
		//$('.add-to-fav[data-id="' + id + '"]').find('img').attr('src','/local/templates/isonex2024/img/icon-product-heart-active.svg');
		$('.add-to-fav[data-id="' + id + '"]').addClass('favourite-add--active');
      }
      if (result.res == 2) {
        //$('.favourite-add[data-item="' + id + '"]').removeClass(
        //  "favourite-add--active"
        //);
		//$('.add-to-fav[data-id="' + id + '"]').find('img').attr('src','/local/templates/isonex2024/img/icon-product-heart.svg');
		$('.add-to-fav[data-id="' + id + '"]').removeClass('favourite-add--active');
      }
      //$('.favorites-cnt').html(result.count);
      // if (+(result.count > 0)) {
      //   $('.favorites-cnt').removeClass('hidden');
      // } else {
      //   $('.favorites-cnt').addClass('hidden');
      // }
      setTimeout(()=>{
        $.ajax({
          url: "/include/ajax/favorite_count.php",
          type: "GET",
          dataType: "html",
          success: function (response) {
            var result = $.parseJSON(response);
              $('.favorites-cnt').html(result.count);
              if (+(result.count > 0)) {
                $('.favorites-cnt').removeClass('hidden');
              } else {
                $('.favorites-cnt').addClass('hidden');
              }
              if (window.location.pathname == '/personal/wishlist/') {
                $('.favourites-hero__title-amount.sonex-text-size-m').html(result.count+' товаров');
              }
              if (window.location.pathname == '/personal/wishlist/' && result.count == 0) {
                window.location.reload();
              }
          }
        });
      },150);
    },
    error: function (jqXHR, textStatus, errorThrown) {
      console.log("Error: " + errorThrown);
    },
  });
}

/* Избранное */

function changeCompareList(action, id, $cntContainer, compareUrl) {
  $.ajax({
    url: compareUrl + "?action=" + action + "&id=" + id,
    method: "POST",
    dataType: "json",
    data: {
      id: id,
    },
    success: function (response) {
      // раньше компонент возвращал не валидный json, приходилось парсить
      // response = response.replace(/\'/g, '"');
      // response = $.parseJSON(response);//parse JSON

      if (response.STATUS === "OK") {
        //  console.log('Товар добавлен в список сравнения');
      } else {
        //  console.log('Ошибка добавления в список сравнения');
      }

      if (response.COUNT !== 0) {
        $cntContainer.removeClass("hidden").html(response.COUNT);
      } else {
        $cntContainer.addClass("hidden").html(response.COUNT);
      }

      if (window.location.pathname == '/catalog/compare/') {
        window.location.reload();
      }
    },
    error: function (request, status, error) {
      // console.log('Произошла ошибка:' + error);
    },
  });
}

function addToCompareList(id, $cntContainer, compareUrl) {
  changeCompareList("ADD_TO_COMPARE_LIST", id, $cntContainer, compareUrl);
}

function removeFromCompareList(id, $cntContainer, compareUrl) {
  changeCompareList("DELETE_FROM_COMPARE_LIST", id, $cntContainer, compareUrl);
}

$(document).ready(function () {
  $(document).on("click", ".add-to-compare", function () {
    let $this = $(this);
    let id = $this.attr("data-id");
    let $cntContainer = $(".compare-cnt");

    let compareUrl = '/include/ajax/compare.php';//$this.attr("href");

    if ($this.hasClass("comparition-add--active")) {
      $this.removeClass("comparition-add--active");
      removeFromCompareList(id, $cntContainer, compareUrl);
    } else {
      $this.addClass("comparition-add--active");
      addToCompareList(id, $cntContainer, compareUrl);
    }

    return false;
  });

  $(document).on('click', '.deleteFromCompare', function () {
    let $this = $(this);
    let id = $this.attr("data-prod-id");
    let $cntContainer = $(".compare-cnt");
    let compareUrl = '/include/ajax/compare.php';//$this.attr("href");

    removeFromCompareList(id, $cntContainer, compareUrl);
  });
  
  
	$.get('/include/ajax/compare_get.php',function(data){
	  
		
		if(data.arr) {
			
			$.each(data.arr,function(index,id){
				$('.add-to-compare[data-id="' + id + '"]').addClass('comparition-add--active');
			});
				
		}
	  
	},'json');
  
  
	$.get('/include/ajax/favorite_count.php',function(data){
	  
		if(data.count) {
			$('.favorites-cnt').text(data.count);
			$('.favorites-cnt').removeClass('hidden');
		}
		
		if(data.arr) {
			
			$.each(data.arr,function(index,id){
				console.log($('.add-to-fav[data-id="' + id + '"]'));
				//$('.add-to-fav[data-id="' + id + '"]').find('img').attr('src','/local/templates/isonex2024/img/icon-product-heart-active.svg');
				$('.add-to-fav[data-id="' + id + '"]').addClass('favourite-add--active');
			});
				
		}
	  
	},'json');
  
 
 
