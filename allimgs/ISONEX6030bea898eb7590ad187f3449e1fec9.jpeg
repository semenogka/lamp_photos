$(document).on('change', '.home-send-request__form [name="PHONE"]', changeBackFormPhone);
$(document).on('keyup', '.home-send-request__form [name="EMAIL"]', changeBackFormEmail);
$(document).on('change', '.home-send-request__form [name="EMAIL"]', changeBackFormEmail);
$(document).on('keyup', '.home-send-request__form input, .home-send-request__form textarea', checkBtnDisabled);
	
function changeBackFormPhone() {
	if ($(this).val().length < 16) {
		$(this).closest('.input').addClass('error');
	}
}
function changeBackFormEmail() {
	if ($(this).val().length < 8 || !$(this).val().includes('@')) {
		$(this).closest('.input').addClass('error');
	} else {
		$(this).closest('.input').removeClass('error');
	}
}

function checkBtnDisabled() {
	let ORG_NAME = $('[name="ORG_NAME"]'),
		PHONE = $('[name="PHONE"]'),
		EMAIL = $('[name="EMAIL"]'),
		SITY = $('[name="SITY"]'),
		NAME = $('[name="NAME"]'),
		VID = $('[name="VID"]'),
		notValid = 0;

	if ($(ORG_NAME).val().length < 3) {
		notValid++;
	}

	if ($(PHONE).val().length < 16) {
		notValid++;
	} else {
		$(PHONE).closest('.input').removeClass('error');
	}

	if ($(EMAIL).val().length < 8 && !$(EMAIL).val().includes('@')) {
		notValid++;
	} else {
		$(EMAIL).closest('.input').removeClass('error');
	}

	if ($(SITY).val().length < 3) {
		notValid++;
	}

	if ($(NAME).val().length < 3) {
		notValid++;
	}

	if ($(VID).val().length < 3) {
		notValid++;
	}
	
	console.log(notValid);

	if (notValid == 0) {
		$('.home-send-request__submit .btn').removeAttr('disabled');
	} else {
		$('.home-send-request__submit .btn').attr('disabled', '');
	}
}

	var wait = false;

    var $window = $(window);

    $window.on('scroll', function () {
	
        var $element = $('#show-more'),
        offset = 100; // расстояние от верха экрана до появления элемента
		
		var $element2 = $('.auto-show-more .show-more');
		
		if($element.length) {
			
			var elementTop = $element.offset().top;
			var scrollPosition = $window.scrollTop(); // текущая позиция прокрутки

			if ((scrollPosition + $window.height()) >= (elementTop - offset)) {
				$element.click(); // кликаем по элементу
			}
			
		}
		if($element2.length) {
			
			var elementTop2 = $element2.offset().top;
			var scrollPosition2 = $window.scrollTop(); // текущая позиция прокрутки

			if ((scrollPosition2 + $window.height()) >= (elementTop2 - offset)) {
				$element2.click(); // кликаем по элементу
			}
			
		}
    });
	
