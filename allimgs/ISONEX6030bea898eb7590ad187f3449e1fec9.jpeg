		$('.menu_lvl_1_content').removeClass('active');
		$('.menu_lvl_1_content[data-id="'+id+'"]').addClass('active');
		
	});
	
			$(document).ready(function () {
			var sities = [];

			$(".sity").each(function (index) {
				sities.push($(this).html());
			});


			$("input[name=search]").keyup(function () {
				let val = $(this).val();
				if (val.length > 0) {
					$('.removeInputVal').show();
					$('.stores-map__left-cities').hide();
				} else {
					$('.removeInputVal').hide();
					$('.stores-map__left-cities').show();
					$('.search-input2__results').show();
				}
					let parent = $(this).parent();

					var helps = [];

					sities.forEach(element => {
						let tmp = element.toLowerCase();

						if (tmp.includes(val.toLowerCase())) {
							helps.push(element);
						}
					});

					let html = "";
					if (helps.length > 0) {
						helps.forEach(element => {
							html = html + "<li><button class='sonex-text-size-m' type='button'>" + element + "</button></li>";
						})
						parent.find(".search-input2__results").html(html).show();
					} else {
						parent.find(".search-input2__results").hide();
					}
				//}
				//   return
			});

			$(".search-input2__results").on("click", "button", function () {
				let parent = $(this).parents("form");
				parent.find("input[name=search]").val($(this).html());
			});

			$('.removeInputVal').click(function () {
				$('.search-input2 input').val('');
				$(this).hide();
				$('.search-input2 input').trigger('keyup');
				$('.search-input2__results').hide();
					$('.stores-map__left-cities').show();
			});

		});	
		
