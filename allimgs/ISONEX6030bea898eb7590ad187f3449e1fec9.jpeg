		<script>
		
			const catalogGrid = document.getElementById('main_catalog_grid');
			const cards = document.querySelectorAll('.card');

			const intervals = new Map();
			if(catalogGrid)
			catalogGrid.addEventListener('mouseover', event => {
				const card = event.target.closest('.card');
				if (card && !intervals.has(card)) {
					const intervalId = setInterval(() => {
						changeCarouselImage(card);
					}, 1000);
					intervals.set(card, intervalId);
				}
			});

			if(catalogGrid)
			catalogGrid.addEventListener('mouseout', event => {
				const card = event.target.closest('.card');
				if (card && !card.contains(event.relatedTarget)) {
					clearCarouselImage(card);
				}
			});

			function changeCarouselImage(card) {
				const images = card.querySelectorAll('.images img');
				const activeImageIndex = card.dataset.activeImageIndex;
				if (!activeImageIndex) {
					card.dataset.activeImageIndex = 1;
				} else {
					card.dataset.activeImageIndex = Number(activeImageIndex) + 1 > images.length - 1 ? 0 : Number(activeImageIndex) + 1 % images.length;
				}

				console.log(card.dataset.activeImageIndex);

				images.forEach((image, index) => {
					image.style.display = 'none';
					if (index == card.dataset.activeImageIndex) {
						image.style.display = 'block';
					}
				});
			}

			function clearCarouselImage(card) {
				const images = card.querySelectorAll('.images img');
					images.forEach((image, index) => {
						image.style.display = 'none';
						if (index == 0) {
							image.style.display = 'block';
						}
					});
				clearInterval(intervals.get(card));
				intervals.delete(card);
			}
		</script>
		
		
		
<script>
if(document.getElementById('auth-form'))
document.getElementById('auth-form').addEventListener('submit', function(e) {
    e.preventDefault();

    const login = document.getElementById('login').value;
    const password = document.getElementById('password').value;

    fetch('/local/ajax/auth.php', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: `login=${encodeURIComponent(login)}&password=${encodeURIComponent(password)}`
    })
    .then(response => response.json())
    .then(data => {
        const messageElem = document.getElementById('auth-message');
        if (data.success) {
            messageElem.style.display = 'block';
            messageElem.style.color = 'green';
            messageElem.innerText = 'Успешная авторизация';
            window.location.href = '/';
        } else {
            messageElem.style.display = 'block';
            messageElem.style.color = 'red';
            messageElem.innerText = data.message || 'Ошибка авторизации';
        }
    })
    .catch(error => {
        console.error('Ошибка:', error);
    });
});
</script>

